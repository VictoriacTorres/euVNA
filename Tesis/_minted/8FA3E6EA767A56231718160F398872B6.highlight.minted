\PYG{c+c1}{\PYGZsh{} ==================== Hilo de trabajo: corre un barrido sin trabar la GUI ====================}

\PYG{k}{class}\PYG{+w}{ }\PYG{n+nc}{SweepWorker}\PYG{p}{(}\PYG{n}{QThread}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Ejecuta core.barrido() en un hilo aparte y reenvia sus resultados como señales Qt.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{n}{punto\PYGZus{}medido} \PYG{o}{=} \PYG{n}{pyqtSignal}\PYG{p}{(}\PYG{n+nb}{int}\PYG{p}{,} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n+nb}{float}\PYG{p}{,} \PYG{n+nb}{complex}\PYG{p}{,} \PYG{n+nb}{float}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} i, n, f\PYGZus{}rf, s11, f\PYGZus{}batido}
    \PYG{n}{terminado} \PYG{o}{=} \PYG{n}{pyqtSignal}\PYG{p}{(}\PYG{n+nb}{object}\PYG{p}{,} \PYG{n+nb}{object}\PYG{p}{)}                      \PYG{c+c1}{\PYGZsh{} freqs (ndarray), s11 (ndarray)}
    \PYG{n}{abortado} \PYG{o}{=} \PYG{n}{pyqtSignal}\PYG{p}{()}
    \PYG{n}{error} \PYG{o}{=} \PYG{n}{pyqtSignal}\PYG{p}{(}\PYG{n+nb}{str}\PYG{p}{)}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{ser}\PYG{p}{,} \PYG{n}{frecuencias\PYGZus{}rf}\PYG{p}{,} \PYG{n}{coef\PYGZus{}filtro}\PYG{p}{,} \PYG{n}{config}\PYG{p}{,} \PYG{n}{parent}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
        \PYG{n+nb}{super}\PYG{p}{()}\PYG{o}{.}\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{(}\PYG{n}{parent}\PYG{p}{)}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{ser} \PYG{o}{=} \PYG{n}{ser}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{frecuencias\PYGZus{}rf} \PYG{o}{=} \PYG{n}{frecuencias\PYGZus{}rf}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{coef\PYGZus{}filtro} \PYG{o}{=} \PYG{n}{coef\PYGZus{}filtro}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{config} \PYG{o}{=} \PYG{n}{config}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}abortar} \PYG{o}{=} \PYG{k+kc}{False}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{abortar}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}abortar} \PYG{o}{=} \PYG{k+kc}{True}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{run}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
        \PYG{k}{try}\PYG{p}{:}
            \PYG{n}{freqs}\PYG{p}{,} \PYG{n}{s11} \PYG{o}{=} \PYG{n}{core}\PYG{o}{.}\PYG{n}{barrido}\PYG{p}{(}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{ser}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{frecuencias\PYGZus{}rf}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{coef\PYGZus{}filtro}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{config}\PYG{p}{,}
                \PYG{n}{on\PYGZus{}point}\PYG{o}{=}\PYG{k}{lambda} \PYG{n}{i}\PYG{p}{,} \PYG{n}{n}\PYG{p}{,} \PYG{n}{f}\PYG{p}{,} \PYG{n}{s}\PYG{p}{,} \PYG{n}{fb}\PYG{p}{:} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{punto\PYGZus{}medido}\PYG{o}{.}\PYG{n}{emit}\PYG{p}{(}\PYG{n}{i}\PYG{p}{,} \PYG{n}{n}\PYG{p}{,} \PYG{n}{f}\PYG{p}{,} \PYG{n}{s}\PYG{p}{,} \PYG{n}{fb}\PYG{p}{),}
                \PYG{n}{should\PYGZus{}abort}\PYG{o}{=}\PYG{k}{lambda}\PYG{p}{:} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}abortar}\PYG{p}{,}
            \PYG{p}{)}
            \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{terminado}\PYG{o}{.}\PYG{n}{emit}\PYG{p}{(}\PYG{n}{freqs}\PYG{p}{,} \PYG{n}{s11}\PYG{p}{)}
        \PYG{k}{except} \PYG{n}{core}\PYG{o}{.}\PYG{n}{BarridoAbortado}\PYG{p}{:}
            \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{abortado}\PYG{o}{.}\PYG{n}{emit}\PYG{p}{()}
        \PYG{k}{except} \PYG{n+ne}{Exception} \PYG{k}{as} \PYG{n}{e}\PYG{p}{:}  \PYG{c+c1}{\PYGZsh{} noqa: BLE001 \PYGZhy{} se muestra en la GUI}
            \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{error}\PYG{o}{.}\PYG{n}{emit}\PYG{p}{(}\PYG{n+nb}{str}\PYG{p}{(}\PYG{n}{e}\PYG{p}{))}


\PYG{c+c1}{\PYGZsh{} ==================== Dibujo del abaco de Smith (fondo estatico) ====================}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{dibujar\PYGZus{}fondo\PYGZus{}smith}\PYG{p}{(}\PYG{n}{ax}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Dibuja el grillado clasico de un abaco de Smith (r y x constantes).\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{clear}\PYG{p}{()}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{set\PYGZus{}aspect}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}equal\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{axis}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}off\PYGZdq{}}\PYG{p}{)}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{set\PYGZus{}xlim}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mf}{1.15}\PYG{p}{,} \PYG{l+m+mf}{1.15}\PYG{p}{)}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{set\PYGZus{}ylim}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mf}{1.15}\PYG{p}{,} \PYG{l+m+mf}{1.15}\PYG{p}{)}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{set\PYGZus{}title}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Abaco de Smith\PYGZdq{}}\PYG{p}{)}

    \PYG{n}{theta} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linspace}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{2} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{pi}\PYG{p}{,} \PYG{l+m+mi}{400}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Circulo unitario (|Gamma| = 1)}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{plot}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{cos}\PYG{p}{(}\PYG{n}{theta}\PYG{p}{),} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sin}\PYG{p}{(}\PYG{n}{theta}\PYG{p}{),} \PYG{n}{color}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}black\PYGZdq{}}\PYG{p}{,} \PYG{n}{linewidth}\PYG{o}{=}\PYG{l+m+mf}{1.0}\PYG{p}{)}
    \PYG{n}{ax}\PYG{o}{.}\PYG{n}{axhline}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{n}{color}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}gray\PYGZdq{}}\PYG{p}{,} \PYG{n}{linewidth}\PYG{o}{=}\PYG{l+m+mf}{0.5}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Circulos de resistencia constante (r = 0, 0.2, 0.5, 1, 2, 5)}
    \PYG{k}{for} \PYG{n}{r} \PYG{o+ow}{in} \PYG{p}{(}\PYG{l+m+mf}{0.0}\PYG{p}{,} \PYG{l+m+mf}{0.2}\PYG{p}{,} \PYG{l+m+mf}{0.5}\PYG{p}{,} \PYG{l+m+mf}{1.0}\PYG{p}{,} \PYG{l+m+mf}{2.0}\PYG{p}{,} \PYG{l+m+mf}{5.0}\PYG{p}{):}
        \PYG{n}{cx} \PYG{o}{=} \PYG{n}{r} \PYG{o}{/} \PYG{p}{(}\PYG{n}{r} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{)}
        \PYG{n}{rad} \PYG{o}{=} \PYG{l+m+mi}{1} \PYG{o}{/} \PYG{p}{(}\PYG{n}{r} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{)}
        \PYG{n}{x} \PYG{o}{=} \PYG{n}{cx} \PYG{o}{+} \PYG{n}{rad} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{cos}\PYG{p}{(}\PYG{n}{theta}\PYG{p}{)}
        \PYG{n}{y} \PYG{o}{=} \PYG{n}{rad} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sin}\PYG{p}{(}\PYG{n}{theta}\PYG{p}{)}
        \PYG{n}{ax}\PYG{o}{.}\PYG{n}{plot}\PYG{p}{(}\PYG{n}{x}\PYG{p}{,} \PYG{n}{y}\PYG{p}{,} \PYG{n}{color}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}gray\PYGZdq{}}\PYG{p}{,} \PYG{n}{linewidth}\PYG{o}{=}\PYG{l+m+mf}{0.5}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Arcos de reactancia constante (x = +/\PYGZhy{} 0.2, 0.5, 1, 2, 5)}
    \PYG{n}{t} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linspace}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{2} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{pi}\PYG{p}{,} \PYG{l+m+mi}{800}\PYG{p}{)}
    \PYG{k}{for} \PYG{n}{x\PYGZus{}val} \PYG{o+ow}{in} \PYG{p}{(}\PYG{l+m+mf}{0.2}\PYG{p}{,} \PYG{l+m+mf}{0.5}\PYG{p}{,} \PYG{l+m+mf}{1.0}\PYG{p}{,} \PYG{l+m+mf}{2.0}\PYG{p}{,} \PYG{l+m+mf}{5.0}\PYG{p}{):}
        \PYG{k}{for} \PYG{n}{signo} \PYG{o+ow}{in} \PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{):}
            \PYG{n}{xv} \PYG{o}{=} \PYG{n}{signo} \PYG{o}{*} \PYG{n}{x\PYGZus{}val}
            \PYG{n}{cx}\PYG{p}{,} \PYG{n}{cy} \PYG{o}{=} \PYG{l+m+mf}{1.0}\PYG{p}{,} \PYG{l+m+mf}{1.0} \PYG{o}{/} \PYG{n}{xv}
            \PYG{n}{rad} \PYG{o}{=} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{l+m+mf}{1.0} \PYG{o}{/} \PYG{n}{xv}\PYG{p}{)}
            \PYG{n}{gx} \PYG{o}{=} \PYG{n}{cx} \PYG{o}{+} \PYG{n}{rad} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{cos}\PYG{p}{(}\PYG{n}{t}\PYG{p}{)}
            \PYG{n}{gy} \PYG{o}{=} \PYG{n}{cy} \PYG{o}{+} \PYG{n}{rad} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sin}\PYG{p}{(}\PYG{n}{t}\PYG{p}{)}
            \PYG{n}{mask} \PYG{o}{=} \PYG{n}{gx} \PYG{o}{**} \PYG{l+m+mi}{2} \PYG{o}{+} \PYG{n}{gy} \PYG{o}{**} \PYG{l+m+mi}{2} \PYG{o}{\PYGZlt{}=} \PYG{l+m+mf}{1.0} \PYG{o}{+} \PYG{l+m+mf}{1e\PYGZhy{}6}
            \PYG{n}{ax}\PYG{o}{.}\PYG{n}{plot}\PYG{p}{(}\PYG{n}{gx}\PYG{p}{[}\PYG{n}{mask}\PYG{p}{],} \PYG{n}{gy}\PYG{p}{[}\PYG{n}{mask}\PYG{p}{],} \PYG{n}{color}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}gray\PYGZdq{}}\PYG{p}{,} \PYG{n}{linewidth}\PYG{o}{=}\PYG{l+m+mf}{0.5}\PYG{p}{)}


