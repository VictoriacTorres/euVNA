\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{vna\PYGZus{}core.py}
\PYG{l+s+sd}{============}
\PYG{l+s+sd}{Nucleo de adquisicion y calculo para el VNA casero (2x ADF4351 + Arduino +}
\PYG{l+s+sd}{placa de sonido). Adaptado de VNA\PYGZus{}calibrado.py para poder ser llamado desde}
\PYG{l+s+sd}{una interfaz grafica: sin input()/tkinter bloqueantes, con callback de}
\PYG{l+s+sd}{progreso por punto y posibilidad de abortar un barrido en curso.}

\PYG{l+s+sd}{La logica de senales (filtro FIR, FFT, deteccion del tono de batido,}
\PYG{l+s+sd}{algebra de calibracion SOL) es la misma que la del script original; lo}
\PYG{l+s+sd}{unico que cambia es como se invoca.}

\PYG{l+s+sd}{Requisitos:}
\PYG{l+s+sd}{    pip install pyserial sounddevice numpy scipy}
\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}

