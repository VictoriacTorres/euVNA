\PYG{c+c1}{\PYGZsh{} ==================== Configuración: filtro FIR + FFT ====================}
\PYG{n}{F\PYGZus{}CENTRO\PYGZus{}FILTRO} \PYG{o}{=} \PYG{l+m+mi}{10000}       \PYG{c+c1}{\PYGZsh{} Hz, tono de batido esperado}
\PYG{n}{ANCHO\PYGZus{}BANDA\PYGZus{}FILTRO} \PYG{o}{=} \PYG{l+m+mi}{200}     \PYG{c+c1}{\PYGZsh{} Hz}
\PYG{n}{NUMTAPS\PYGZus{}FILTRO} \PYG{o}{=} \PYG{l+m+mi}{1001}        \PYG{c+c1}{\PYGZsh{} debe ser menor que la cantidad de muestras por captura}
\PYG{n}{VENTANA\PYGZus{}FFT} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}flattop\PYGZdq{}}
\PYG{c+c1}{\PYGZsh{} Banda donde se busca el pico del tono de batido (Hz)}
\PYG{n}{BANDA\PYGZus{}BUSQUEDA\PYGZus{}PICO} \PYG{o}{=} \PYG{p}{(}\PYG{n}{F\PYGZus{}CENTRO\PYGZus{}FILTRO} \PYG{o}{\PYGZhy{}} \PYG{n}{ANCHO\PYGZus{}BANDA\PYGZus{}FILTRO} \PYG{o}{/} \PYG{l+m+mi}{2}\PYG{p}{,}
                        \PYG{n}{F\PYGZus{}CENTRO\PYGZus{}FILTRO} \PYG{o}{+} \PYG{n}{ANCHO\PYGZus{}BANDA\PYGZus{}FILTRO} \PYG{o}{/} \PYG{l+m+mi}{2}\PYG{p}{)}
\PYG{c+c1}{\PYGZsh{} ==================================================================}

\PYG{n}{FRECUENCIAS\PYGZus{}EXCLUIDAS\PYGZus{}MHZ} \PYG{o}{=} \PYG{p}{[]}
\PYG{c+c1}{\PYGZsh{} ==================== Calibración ====================}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{calculo\PYGZus{}errores} \PYG{p}{(}\PYG{n}{GM\PYGZus{}CC}\PYG{p}{,} \PYG{n}{GM\PYGZus{}CA}\PYG{p}{,} \PYG{n}{GM\PYGZus{}50}\PYG{p}{,} \PYG{n}{n}\PYG{p}{):}
    \PYG{n}{e\PYGZus{}00}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{empty}\PYG{p}{(}\PYG{n}{n}\PYG{p}{,}\PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{complex}\PYG{p}{)}   \PYG{c+c1}{\PYGZsh{}inicializo un vector de long n vacio con valores complejos}
    \PYG{n}{e\PYGZus{}11}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{empty}\PYG{p}{(}\PYG{n}{n}\PYG{p}{,}\PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{complex}\PYG{p}{)}
    \PYG{n}{delta\PYGZus{}e}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{empty}\PYG{p}{(}\PYG{n}{n}\PYG{p}{,}\PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{complex}\PYG{p}{)}

    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{n}\PYG{p}{):}
        \PYG{n}{A}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{([}
            \PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{n}{GM\PYGZus{}CC}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{l+m+mi}{1}\PYG{p}{],} \PYG{c+c1}{\PYGZsh{}CC}
            \PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{],}         \PYG{c+c1}{\PYGZsh{}50}
            \PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{GM\PYGZus{}CA}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}  \PYG{c+c1}{\PYGZsh{}CA}
        \PYG{p}{],}\PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{complex}\PYG{p}{)}
        \PYG{n}{B}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{([}\PYG{n}{GM\PYGZus{}CC}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{GM\PYGZus{}50}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{GM\PYGZus{}CA}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]])}
        \PYG{n}{sol}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{linalg}\PYG{o}{.}\PYG{n}{solve}\PYG{p}{(}\PYG{n}{A}\PYG{p}{,}\PYG{n}{B}\PYG{p}{)}
        \PYG{n}{e\PYGZus{}00}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{o}{=}\PYG{n}{sol}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}
        \PYG{n}{e\PYGZus{}11}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{o}{=}\PYG{n}{sol}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}
        \PYG{n}{delta\PYGZus{}e}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{o}{=}\PYG{n}{sol}\PYG{p}{[}\PYG{l+m+mi}{2}\PYG{p}{]} 
    \PYG{k}{return} \PYG{n}{e\PYGZus{}00}\PYG{p}{,} \PYG{n}{e\PYGZus{}11}\PYG{p}{,} \PYG{n}{delta\PYGZus{}e}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{correccion\PYGZus{}punto}\PYG{p}{(}\PYG{n}{gm}\PYG{p}{,} \PYG{n}{e\PYGZus{}00}\PYG{p}{,} \PYG{n}{e\PYGZus{}11}\PYG{p}{,} \PYG{n}{delta\PYGZus{}e}\PYG{p}{):}
    \PYG{n}{denominador} \PYG{o}{=} \PYG{n}{gm} \PYG{o}{*} \PYG{n}{e\PYGZus{}11} \PYG{o}{\PYGZhy{}} \PYG{n}{delta\PYGZus{}e}
    \PYG{k}{if} \PYG{n+nb}{abs}\PYG{p}{(}\PYG{n}{denominador}\PYG{p}{)} \PYG{o}{\PYGZlt{}} \PYG{l+m+mf}{1e\PYGZhy{}15}\PYG{p}{:}
        \PYG{n}{denominador} \PYG{o}{=} \PYG{l+m+mf}{1e\PYGZhy{}15} \PYG{o}{+} \PYG{l+m+mf}{1e\PYGZhy{}15j}
    \PYG{k}{return} \PYG{p}{(}\PYG{n}{gm} \PYG{o}{\PYGZhy{}} \PYG{n}{e\PYGZus{}00}\PYG{p}{)} \PYG{o}{/} \PYG{n}{denominador}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{correccion}\PYG{p}{(}\PYG{n}{GM}\PYG{p}{,}\PYG{n}{e\PYGZus{}00}\PYG{p}{,}\PYG{n}{e\PYGZus{}11}\PYG{p}{,}\PYG{n}{delta\PYGZus{}e}\PYG{p}{,}\PYG{n}{n}\PYG{p}{):}
    \PYG{n}{Gamma}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{empty}\PYG{p}{(}\PYG{n}{n}\PYG{p}{,}\PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{complex}\PYG{p}{)}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{n}\PYG{p}{):}
        \PYG{n}{Gamma}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{n}{correccion\PYGZus{}punto}\PYG{p}{(}\PYG{n}{GM}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{e\PYGZus{}00}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{e\PYGZus{}11}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],} \PYG{n}{delta\PYGZus{}e}\PYG{p}{[}\PYG{n}{i}\PYG{p}{])}
    \PYG{k}{return} \PYG{n}{Gamma}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{guardar\PYGZus{}calibracion\PYGZus{}csv}\PYG{p}{(}\PYG{n}{path}\PYG{p}{,} \PYG{n}{freqs}\PYG{p}{,} \PYG{n}{e\PYGZus{}00}\PYG{p}{,} \PYG{n}{e\PYGZus{}11}\PYG{p}{,} \PYG{n}{delta\PYGZus{}e}\PYG{p}{):}
    \PYG{k}{with} \PYG{n+nb}{open}\PYG{p}{(}\PYG{n}{path}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}w\PYGZdq{}}\PYG{p}{,} \PYG{n}{newline}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}\PYGZdq{}}\PYG{p}{,} \PYG{n}{encoding}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}utf\PYGZhy{}8\PYGZdq{}}\PYG{p}{)} \PYG{k}{as} \PYG{n}{f}\PYG{p}{:}
        \PYG{n}{writer} \PYG{o}{=} \PYG{n}{csv}\PYG{o}{.}\PYG{n}{writer}\PYG{p}{(}\PYG{n}{f}\PYG{p}{)}
        \PYG{n}{writer}\PYG{o}{.}\PYG{n}{writerow}\PYG{p}{([}\PYG{l+s+s2}{\PYGZdq{}freq\PYGZus{}MHz\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}e\PYGZus{}00\PYGZus{}real\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}e\PYGZus{}00\PYGZus{}imag\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}e\PYGZus{}11\PYGZus{}real\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}e\PYGZus{}11\PYGZus{}imag\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}delta\PYGZus{}e\PYGZus{}real\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}delta\PYGZus{}e\PYGZus{}imag\PYGZdq{}}\PYG{p}{])}
        \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{freqs}\PYG{p}{)):}
            \PYG{n}{writer}\PYG{o}{.}\PYG{n}{writerow}\PYG{p}{([}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{freqs}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{l+s+si}{:}\PYG{l+s+s2}{.6f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} 
                             \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{e\PYGZus{}00}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{o}{.}\PYG{n}{real}\PYG{l+s+si}{:}\PYG{l+s+s2}{.10e}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{e\PYGZus{}00}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{o}{.}\PYG{n}{imag}\PYG{l+s+si}{:}\PYG{l+s+s2}{.10e}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,}
                             \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{e\PYGZus{}11}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{o}{.}\PYG{n}{real}\PYG{l+s+si}{:}\PYG{l+s+s2}{.10e}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{e\PYGZus{}11}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{o}{.}\PYG{n}{imag}\PYG{l+s+si}{:}\PYG{l+s+s2}{.10e}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,}
