\PYG{n}{ARCHIVO\PYGZus{}CSV} \PYG{o}{=} \PYG{n}{os}\PYG{o}{.}\PYG{n}{path}\PYG{o}{.}\PYG{n}{join}\PYG{p}{(}\PYG{n}{CARPETA\PYGZus{}CSV}\PYG{p}{,} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}resultado\PYGZus{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{F\PYGZus{}INICIO\PYGZus{}MHZ}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZus{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{F\PYGZus{}FIN\PYGZus{}MHZ}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZus{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{F\PYGZus{}PASO\PYGZus{}MHZ}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZus{}cableaCA\PYGZus{}2nov.csv\PYGZdq{}}\PYG{p}{)}
\PYG{n}{NOMBRE\PYGZus{}FIGURA\PYGZus{}BASE} \PYG{o}{=} \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}s11\PYGZus{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{F\PYGZus{}INICIO\PYGZus{}MHZ}\PYG{l+s+si}{:}\PYG{l+s+s2}{.3f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZus{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{F\PYGZus{}FIN\PYGZus{}MHZ}\PYG{l+s+si}{:}\PYG{l+s+s2}{.3f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZus{}}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{F\PYGZus{}PASO\PYGZus{}MHZ}\PYG{l+s+si}{:}\PYG{l+s+s2}{.3f}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}
