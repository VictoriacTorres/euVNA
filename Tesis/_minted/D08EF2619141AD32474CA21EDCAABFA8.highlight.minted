\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{capturar\PYGZus{}audio}\PYG{p}{(}\PYG{n}{duracion\PYGZus{}s}\PYG{p}{,} \PYG{n}{fs}\PYG{p}{,} \PYG{n}{dispositivo}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
