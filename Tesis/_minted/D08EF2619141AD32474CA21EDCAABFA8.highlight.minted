\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{Barrido de RF + adquisición + cálculo de S11.}

\PYG{l+s+sd}{Por cada frecuencia del barrido:}
\PYG{l+s+sd}{    1. Se le manda la frecuencia al Arduino (adf4351\PYGZus{}serial.ino) por serial.}
\PYG{l+s+sd}{    2. Se graba una captura corta desde la entrada line\PYGZhy{}in (ref = canal}
\PYG{l+s+sd}{       izquierdo, medición = canal derecho).}
\PYG{l+s+sd}{    3. Se filtra cada canal con un FIR pasabanda alrededor de 1 kHz.}
\PYG{l+s+sd}{    4. Se calcula la FFT compleja de ambos canales.}
\PYG{l+s+sd}{    5. Se busca el pico del tono de batido en el canal de referencia, y}
\PYG{l+s+sd}{       se toma el mismo bin en el canal de medición.}
\PYG{l+s+sd}{    6. S11\PYGZus{}punto = medición[bin] / referencia[bin].}

\PYG{l+s+sd}{Al terminar se grafica y se guardan los resultados en un .csv y en un .pk la imagen interactiva de matplotlib.}

\PYG{l+s+sd}{Requisitos:}
\PYG{l+s+sd}{    pip install pyserial sounddevice numpy scipy matplotlib}
\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}

